{
  "permissions": {
    "deny": [
      "Edit(./sim/**)",
      "Write(./sim/**)",
      "Edit(./dashboard.py)",
      "Write(./dashboard.py)",
      "Read(./sim/*.pack)",
      "Read(./sim/affiliate_center.py)",
      "Read(./sim/pack.py)",
      "Read(**/state.db)"
    ],
    "allow": [
      "Read(./sim/API.md)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sim-internals.sh"
          }
        ]
      }
    ]
  }
}
